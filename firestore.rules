rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MODÈLE : remplacer les deux adresses UNIQUEMENT dans la console Firebase
    // (Firestore → Règles). Ne jamais mettre les vraies adresses dans ce fichier.
    function estMembre() {
      return request.auth != null
        && request.auth.token.email_verified
        && request.auth.token.email.lower() in ['ADRESSE_DANIEL', 'ADRESSE_MATHIEU'];
    }
    // Qui est qui : chacun crée une fois sa fiche à la première connexion.
    match /membres/{uid} {
      allow read: if estMembre() && request.auth.uid == uid;
      allow create: if estMembre() && request.auth.uid == uid
        && request.resource.data.joueur in ['daniel', 'mathieu'];
    }
    // Tout le reste est privé : lecture et écriture réservées à nous deux.
    match /{collection}/{doc} {
      allow read, write: if estMembre() && collection in ['avis', 'soirees', 'prets'];
    }
  }
}
